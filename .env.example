ORCHFLOW_ENV=development
ORCHFLOW_API_HOST=localhost
ORCHFLOW_API_PORT=8000
ORCHFLOW_DATABASE_URL=sqlite:///./data/orchflow.db
ORCHFLOW_JWT_SECRET=change-this-in-local-env
ORCHFLOW_JWT_ALGORITHM=HS256
ORCHFLOW_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ORCHFLOW_AI_PROVIDER=ollama
ORCHFLOW_AI_PROVIDER_URL=http://localhost:11434
ORCHFLOW_RUNTIME_DIR=./runtime
ORCHFLOW_DATA_DIR=./data
ORCHFLOW_LOG_LEVEL=INFO
